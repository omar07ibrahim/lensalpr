<?xml version="1.0" encoding="utf-8"?>
<!--
    Scrolling because the scanner is locked to landscape: on a phone held sideways the dialog is
    barely a couple of hundred pixels tall, and a photo plus four lines of detail already fill it.
    Without this the controls at the bottom are simply off-screen and unreachable.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_thumb"
            android:contentDescription="@string/cd_vehicle_thumb"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/plate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textColor="@color/accent"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/makeModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!--
            Its own control rather than a fourth dialog button: a dialog offers three, and all three
            already carry decisions the driver makes far more often. Marking a patrol car is a
            deliberate, occasional act, so it gets a place of its own where it cannot be hit by
            accident while reaching for "close".
        -->
        <Button
            android:id="@+id/btnPolice"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/action_police" />
    </LinearLayout>
</ScrollView>
