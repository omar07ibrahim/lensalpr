<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/lockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lockHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editPassword"
            android:layout_width="match_parent"
            android:maxWidth="360dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:autofillHints="password"
            android:gravity="center"
            android:hint="@string/lock_field_hint"
            android:imeOptions="actionDone"
            android:inputType="numberPassword"
            android:letterSpacing="0.15"
            android:maxLength="12"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/ink_stroke"
            android:textSize="24sp" />

        <EditText
            android:id="@+id/editConfirm"
            android:layout_width="match_parent"
            android:maxWidth="360dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="password"
            android:gravity="center"
            android:hint="@string/lock_confirm_hint"
            android:imeOptions="actionDone"
            android:inputType="numberPassword"
            android:letterSpacing="0.15"
            android:maxLength="12"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/ink_stroke"
            android:textSize="24sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lockError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/danger"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/lockAttempts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/warn"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:maxWidth="360dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
